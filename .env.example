# Google Gemini API Configuration (server-side Live AI via @google/genai)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-3.1-flash-lite"

# Optional Anthropic API Configuration (used if GEMINI_API_KEY is not set)
ANTHROPIC_API_KEY="your-anthropic-api-key"
ANTHROPIC_MODEL="claude-sonnet-4-20250514"

# Set to "true" to force deterministic Demo Mode even if an API key is present
DEMO_MODE="false"

# Secret key for signing session authentication tokens
AUTH_SECRET="replace-with-a-random-32-char-secret"

# MongoDB Atlas Configuration (leave empty to fall back to local SQLite)
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0"
MONGODB_DB_NAME="ai_interview_simulator"

# Flask Backend Configuration
FLASK_PORT="5000"
DATABASE_URL="sqlite:///interview_simulator.db"
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# Optional: Proxy Express /api/* requests to a running local Flask backend
# Leave empty to use the built-in Node API handler on port 3000
FLASK_BACKEND_URL=""

# AI Studio Runtime Variables
APP_URL="MY_APP_URL"
